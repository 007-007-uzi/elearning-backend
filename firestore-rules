rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isLoggedIn() && getUserRole() == 'admin';
    }

    function isTeacher() {
      return isLoggedIn() && getUserRole() == 'teacher';
    }

    function isStudent() {
      return isLoggedIn() && getUserRole() == 'student';
    }

    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isLoggedIn();
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /assignments/{assignmentId} {
      allow read: if isLoggedIn();
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isAdmin();
    }

       match /submissions/{submissionId} {
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow read: if isAdmin() || isTeacher() || 
                   (isStudent() && resource.data.studentId == request.auth.uid);
      allow update: if isAdmin() || isTeacher(); // Teacher grading ke liye
    }
    match /quizzes/{quizId} {
      allow read: if isLoggedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /lectures/{lectureId} {
      allow read: if isLoggedIn();
      allow write: if isTeacher() || isAdmin();
    }
  }
}